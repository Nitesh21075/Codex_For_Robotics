<?xml version="1.0"?>
<!-- Generated by RoboPilot. Edit spec.json, not this file, for morphology changes. -->
<robot name="{{ robot_name }}">
  <material name="chassis"><color rgba="0.16 0.28 0.46 1"/></material>
  <material name="wheel"><color rgba="0.07 0.08 0.10 1"/></material>
  <material name="camera"><color rgba="0.82 0.87 0.92 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 -0.04"/><mass value="{{ body_mass }}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
    <visual><origin xyz="0 0 0"/><geometry><box size="{{ body_length }} {{ body_width }} {{ body_height }}"/></geometry><material name="chassis"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="{{ body_length }} {{ body_width }} {{ body_height }}"/></geometry></collision>
    <!-- Passive skids prevent the body from pitching into the ground. -->
    {% for x in [-0.16, 0.16] %}
    <visual><origin xyz="{{ x }} 0 -0.105"/><geometry><sphere radius="0.03"/></geometry><material name="wheel"/></visual>
    <collision><origin xyz="{{ x }} 0 -0.105"/><geometry><sphere radius="0.03"/></geometry></collision>
    {% endfor %}
  </link>

  {% for side, y in [('left', wheel_y), ('right', -wheel_y)] %}
  <link name="{{ side }}_wheel">
    <inertial><origin xyz="0 0 0"/><mass value="{{ wheel_mass }}"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin rpy="1.57079632679 0 0" xyz="0 0 0"/><geometry><cylinder radius="{{ wheel_radius }}" length="{{ wheel_width }}"/></geometry><material name="wheel"/></visual>
    <collision><origin rpy="1.57079632679 0 0" xyz="0 0 0"/><geometry><cylinder radius="{{ wheel_radius }}" length="{{ wheel_width }}"/></geometry></collision>
  </link>
  <joint name="{{ side }}_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="{{ side }}_wheel"/>
    <origin xyz="0 {{ y }} {{ wheel_z }}" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.002" friction="0"/>
  </joint>
  {% endfor %}

  <link name="camera_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
    <visual><origin xyz="0.04 0 {{ camera_z }}"/><geometry><box size="0.05 0.05 0.04"/></geometry><material name="camera"/></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="{{ camera_x }} 0 {{ camera_z }}" rpy="0 0 0"/>
  </joint>
</robot>
